# ────────────────────────────────────────────────────────
# Guardián de Gastos — Backend
# Copia este archivo como `.env` y rellena los valores.
# Obtén las credenciales en: Supabase Dashboard → Project Settings → API
# ────────────────────────────────────────────────────────

# URL pública de tu proyecto Supabase (ej. https://xxxxx.supabase.co)
SUPABASE_URL=

# Service Role Key — SECRETA, NUNCA exponer al frontend
SUPABASE_SERVICE_ROLE_KEY=

# Anon / Public Key — usada para validar JWTs de los usuarios
SUPABASE_ANON_KEY=

# Puerto donde corre el API (por defecto 4000)
PORT=4000

# Origen permitido para CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:8080